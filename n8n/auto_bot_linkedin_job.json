    },
    {
      "id": "29",
      "name": "Telegram Hot Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        4280,
        120
      ],
      "parameters": {
        "chatId": "={{ $('Parse Telegram Command').first().json.chatId || 'DEFAULT_CHAT_ID' }}",
        "text": "={{ ($json.agency_post ? \"POSTED VIA AGENCY - the real employer is hidden\\n\" : \"\") + \"**\" + $json.type + \"** \u2014 score \" + $json.score + \" (\" + $json.band + \")\\n**\" + $json.title + \"**\\n\" + $json.company + \" | \" + ($json.location || \"US Remote\") + \" | \" + ($json.country || \"US\") + \" | \" + $json.source + \"\\n\\n\" + $json.one_line_fit + \"\\n\\n**Angle:** \" + $json.angle + \"\\n**Approach:** \" + $json.approach_role + \"\\n**Asks for:** \" + $json.asks_for + \"\\n**Concern:** \" + $json.concern }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "\u270d\ufe0f Draft outreach",
