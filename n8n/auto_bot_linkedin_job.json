    },
    {
      "id": "21",
      "name": "Score Listing",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        2920,
        240
      ],
      "parameters": {
        "prompt": "=LISTING\ntitle: {{ $json.title }}\ncompany: {{ $json.company }}\nlocation: {{ $json.location }} | {{ $json.country }} | remote={{ $json.remote }}\nsource: {{ $json.source }}  url: {{ $json.url }}  posted_at: {{ $json.posted_at }}\nagency_suspect: {{ $json.agency_suspect }}\ndescription:\n{{ $json.description ? $json.description.slice(0, 5000) : '' }}"
      }
    },
    {
      "id": "22",
      "name": "Google Gemini Chat Model (Scoring)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        2920,
        420
      ],
      "parameters": {
        "modelName": "models/gemini-2.5-flash"
      },
      "credentials": {
        "googlePalmApi": {
          "id": "gemini_cred",
          "name": "Google Gemini account"
        }
      }
    },
    {
      "id": "23",
      "name": "Listing Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.1,
      "position": [
        3100,
        420
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\": \"object\", \"properties\": {\"type\": {\"type\": \"string\", \"enum\": [\"DIRECT_GIG\", \"BUY_SIGNAL\", \"IGNORE\"]}, \"score\": {\"type\": \"integer\"}, \"band\": {\"type\": \"string\", \"enum\": [\"low\", \"medium\", \"high\"]}, \"one_line_fit\": {\"type\": \"string\"}, \"angle\": {\"type\": \"string\"}, \"approach_role\": {\"type\": \"string\"}, \"asks_for\": {\"type\": \"string\"}, \"concern\": {\"type\": \"string\"}, \"agency_post\": {\"type\": \"boolean\"}, \"keep\": {\"type\": \"boolean\"}}, \"required\": [\"type\", \"score\", \"band\", \"one_line_fit\", \"angle\", \"approach_role\", \"asks_for\", \"concern\", \"agency_post\", \"keep\"]}"
      }
    },
    {
      "id": "24",
      "name": "Attach Scores",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3280,
        240
      ],
      "parameters": {
        "jsCode": "const parsed = $json.output || {};\nconst listing = $('Scoring Batch').item.json;\nconst score = Number(parsed.score || 0);\nconst type = parsed.type || 'IGNORE';\nconst keep = (type !== 'IGNORE' && score >= 55);\nconst band = score >= 80 ? 'high' : (score >= 55 ? 'medium' : 'low');\n\nreturn [{\n  json: {\n    ...listing,\n    ...parsed,\n    score,\n    type,\n    keep,\n    band,\n    run_at: new Date().toISOString()\n  }\n}];"
      }
    },
    {
      "id": "25",
      "name": "Log To Ledger",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.3,
      "position": [
        3480,
        240
      ],
      "parameters": {
        "operation": "append",
        "sheetName": "Ledger",
        "documentId": {
          "__rl": true,
          "value": "GOOGLE_SPREADSHEET_ID",
          "mode": "id"
        }
      },
      "continueOnFail": true,
      "credentials": {
        "googleSheetsOAuth2": {
          "id": "sheets_cred",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "26",
      "name": "Keep Relevant",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        3680,
        240
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.keep }}",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "27",
      "name": "Append To Pipeline Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.3,
      "position": [
        3880,
        180
      ],
      "parameters": {
        "operation": "appendOrUpdate",
        "sheetName": "Pipeline",
        "documentId": {
          "__rl": true,
          "value": "GOOGLE_SPREADSHEET_ID",
