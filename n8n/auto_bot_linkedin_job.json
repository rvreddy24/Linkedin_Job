    {
      "id": "28",
      "name": "Hot Only",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        4080,
        180
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.score }}",
              "operation": "largerEqual",
              "value2": 80
            }
