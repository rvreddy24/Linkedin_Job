      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        800
      ],
      "parameters": {
        "jsCode": "const days = Number($('Hunt Config').first().json.cooldown_days || 21);\nconst last = $json.last_touch_at ? new Date($json.last_touch_at) : null;\nconst blocked = last && (Date.now() - last.getTime()) / 86400000 < days;\nreturn [{ json: { ...$json, cooldown: blocked ? 'blocked' : 'allowed' } }];"
      }
    },
