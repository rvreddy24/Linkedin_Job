      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4480,
        240
      ],
      "parameters": {
        "jsCode": "const now = new Date().toISOString();\nconst allScored = $('Attach Scores').all() || [];\nconst kept = allScored.filter(i => i.json.keep).length;\nconst hot = allScored.filter(i => i.json.score >= 80).length;\nconst total = allScored.length;\n\nreturn [{\n  json: {\n    digest_text: `Auto Bot digest \u2014 ${now}\\nScored: ${total}   Kept: ${kept}   Hot: ${hot}`\n  }\n}];"
      }
    },
