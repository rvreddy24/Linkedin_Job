# Auto Bot LinkedIn Job - Environment Secrets
# Copy this file to .env and insert your real keys

# Discord Integration
# Option 1: Instant Webhook (Easiest - zero bot setup, just channel webhook URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Option 2: Interactive Discord Bot (For !hunt, !status, !help commands & buttons)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CHANNEL_ID=YOUR_DISCORD_CHANNEL_ID

# Google Gemini API Key (Sole AI model used for both scoring and outreach drafting)
GEMINI_API_KEY=AIzaSy...

# Job Sources
JOBSPIPE_API_KEY=jp_live_...

# Google Sheets Integration (Optional - SQLite local ledger is used if omitted)
GOOGLE_SHEETS_CREDENTIALS_FILE=config/google_service_account.json
GOOGLE_SPREADSHEET_ID=
